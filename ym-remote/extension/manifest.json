{
  "manifest_version": 3,
  "name": "Пульт для Яндекс Музыки",
  "version": "0.1.0",
  "description": "Управляйте Яндекс Музыкой в браузере с телефона.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Пульт для Яндекс Музыки"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://next.music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.uz/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://next.music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.uz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
